{
  "name": "dsh-llm-balance",
  "version": "0.3.0",
  "description": "Auto-discovered LLM API balances below the chat input: DeepSeek, OpenRouter, SiliconFlow, Moonshot, MiniMax, StepFun, Zhipu, plus no-API providers like Qwen/DashScope.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JonyChan8394/dsh-llm-balance.git"
  },
  "homepage": "https://github.com/JonyChan8394/dsh-llm-balance#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "balance",
    "billing",
    "usage"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6"
  }
}
